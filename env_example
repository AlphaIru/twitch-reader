# RENAME THIS FILE TO .env

# If you want a verbose log, set this to true
VERBOSE_LOG=false

# If you want to use the OpenJTalk voice, set this to true
ENABLE_YOMI=false

# ---------------------------------

# Note: Your login name 
TWITCH_USERNAME=your_login_name

# Note: This is your twitch id not your bot's id
TWITCH_ClIENT_ID=your_twitch_id

# Note: This is your twitch api client id
TWITCH_CLIENT_ID=api_client_id

# Note: This is your twitch api client secret
TWITCH_CLIENT_SECRET=api_client_secret

# Note: Redirect URI after authorization
TWITCH_REDIRECT_URI=http://localhost:3000

# Note: Where these tokens are stored
AUTH_FILE="./auth.toml"

# Note: This is where your bot get its dic
OPEN_JTALK_DICT_PATH=/usr/share/open-jtalk/dic

# Note: This is where your bot locate its voice
OPEN_JTALK_VOICE_PATH=/usr/share/open-jtalk/voices/nitech_jp_atr503_m001.htsvoice

# Note: This is the max character count of the message
MAX_CHAR_COUNT=100

# Note: This is the max queue count
MAX_QUEUE_COUNT=100

# Note: This is the queue drop policy, (either choose "drop_old" or "drop_new")
QUEUE_DROP_POLICY=drop_new
